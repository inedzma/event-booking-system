<Window x:Class="EventBookingSystem.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Booking System - Login" Height="350" Width="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Event Booking System" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1" Text="Email:" Margin="0,5"/>
        <TextBox Grid.Row="1" x:Name="EmailTextBox" Margin="0,25,0,0"/>

        <TextBlock Grid.Row="2" Text="Password:" Margin="0,5"/>
        <PasswordBox Grid.Row="2" x:Name="PasswordBox" Margin="0,25,0,0"/>

        <Button Grid.Row="3" Content="Login" Margin="0,20,0,5" Padding="0,8" Click="LoginButton_Click"/>

        <TextBlock Grid.Row="4" Text="Don't have an account?" Margin="0,15,0,0" HorizontalAlignment="Center"/>
        <Button Grid.Row="5" Content="Register" Margin="0,5,0,0" Padding="0,8" Click="RegisterButton_Click"/>

        <TextBlock x:Name="ErrorText" Grid.Row="5" Foreground="Red" Margin="0,50,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>