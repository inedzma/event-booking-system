<Window x:Class="EventBookingSystem.Desktop.PendingBookingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pending Bookings" Height="500" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="BookingsListBox" Grid.Row="0"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,0">
            <Button Content="Approve Selected" Padding="10,5" Margin="0,0,10,0" Click="ApproveButton_Click"/>
            <Button Content="Reject Selected" Padding="10,5" Margin="0,0,10,0" Click="RejectButton_Click"/>
            <Button Content="Refresh" Padding="10,5" Click="RefreshButton_Click"/>
        </StackPanel>
    </Grid>
</Window>