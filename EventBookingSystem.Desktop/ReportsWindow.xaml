<Window x:Class="EventBookingSystem.Desktop.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reports" Height="600" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,15">
            <Button Content="Group by Category" Padding="8,5" Margin="0,0,8,8" Click="GroupByCategory_Click"/>
            <Button Content="Revenue Report" Padding="8,5" Margin="0,0,8,8" Click="RevenueReport_Click"/>
            <Button Content="Most Popular" Padding="8,5" Margin="0,0,8,8" Click="MostPopular_Click"/>
            <Button Content="Availability" Padding="8,5" Margin="0,0,8,8" Click="Availability_Click"/>
        </WrapPanel>

        <ListBox x:Name="ResultsListBox" Grid.Row="1"/>
    </Grid>
</Window>