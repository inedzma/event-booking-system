<Window x:Class="EventBookingSystem.Desktop.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register" Height="400" Width="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Create an Account" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Name:"/>
        <TextBox Grid.Row="1" x:Name="NameTextBox" Margin="0,20,0,0"/>

        <TextBlock Grid.Row="2" Text="Email:" Margin="0,10,0,0"/>
        <TextBox Grid.Row="2" x:Name="EmailTextBox" Margin="0,30,0,0"/>

        <TextBlock Grid.Row="3" Text="Password:" Margin="0,10,0,0"/>
        <PasswordBox Grid.Row="3" x:Name="PasswordBox" Margin="0,30,0,0"/>

        <Button Grid.Row="4" Content="Register" Margin="0,20,0,0" Padding="0,8" Click="RegisterButton_Click"/>
        <Button Grid.Row="5" Content="Back to Login" Margin="0,10,0,0" Padding="0,8" Click="BackButton_Click"/>

        <TextBlock x:Name="MessageText" Grid.Row="6" Margin="0,15,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>