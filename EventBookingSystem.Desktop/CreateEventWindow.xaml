<Window x:Class="EventBookingSystem.Desktop.CreateEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Event" Height="550" Width="400"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20">
        <TextBlock Text="Event Type:"/>
        <ComboBox x:Name="TypeComboBox" Margin="0,5,0,15" SelectedIndex="0" SelectionChanged="TypeComboBox_SelectionChanged">
            <ComboBoxItem Content="Concert"/>
            <ComboBoxItem Content="Conference"/>
            <ComboBoxItem Content="Workshop"/>
        </ComboBox>

        <TextBlock Text="Title:"/>
        <TextBox x:Name="TitleTextBox" Margin="0,5,0,15"/>

        <TextBlock Text="Date (dd.MM.yyyy):"/>
        <TextBox x:Name="DateTextBox" Margin="0,5,0,15"/>

        <TextBlock Text="Location:"/>
        <TextBox x:Name="LocationTextBox" Margin="0,5,0,15"/>

        <TextBlock Text="Capacity:"/>
        <TextBox x:Name="CapacityTextBox" Margin="0,5,0,15"/>

        <!-- Concert only -->
        <StackPanel x:Name="ConcertPanel">
            <TextBlock Text="Performer:"/>
            <TextBox x:Name="PerformerTextBox" Margin="0,5,0,15"/>
        </StackPanel>

        <!-- Conference only -->
        <StackPanel x:Name="ConferencePanel" Visibility="Collapsed">
            <TextBlock Text="Topic:"/>
            <TextBox x:Name="TopicTextBox" Margin="0,5,0,15"/>
            <TextBlock Text="Number of speakers:"/>
            <TextBox x:Name="SpeakersTextBox" Margin="0,5,0,15"/>
        </StackPanel>

        <!-- Workshop only -->
        <StackPanel x:Name="WorkshopPanel" Visibility="Collapsed">
            <TextBlock Text="Max participants per group:"/>
            <TextBox x:Name="MaxGroupTextBox" Margin="0,5,0,15"/>
        </StackPanel>

        <Button Content="Create Event" Padding="0,8" Margin="0,10,0,0" Click="CreateButton_Click"/>

        <TextBlock x:Name="MessageText" Margin="0,15,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>